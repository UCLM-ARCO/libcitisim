# -*- mode: config; coding: utf-8 -*-

# IceStorm service properties
IceBox.Service.IceStorm = IceStormService:createIceStorm --Ice.Config=tests.config
IceBox.PrintServicesReady = IceStorm is
IceStorm.TopicManager.Endpoints = tcp -h 127.0.0.1 -p 1111
IceStorm.Publish.Endpoints = tcp -h 127.0.0.1
IceStorm.LMDB.Path = /tmp/test-libcitisim-is-db
Freeze.DbEnv.IceStorm.DbHome = /tmp/test-libcitisim-is-db


# Property services configuration
PropertyServer.Data = /tmp/ps.json
Adapter.Endpoints = tcp -p 9090


# Welcome service properties
WelcomeServiceAdapter.Endpoints = tcp -h 127.0.0.1 -p 1112


# LibCitisim properties
LibCitisim.Debug = True
LibCitisimAdapter.Endpoints = tcp -h 127.0.0.1
TopicManager.Proxy = IceStorm/TopicManager -t:tcp -h 127.0.0.1 -p 1111
WelcomeServer.Proxy = WelcomeServer -t:tcp -h 127.0.0.1 -p 1112
PropertyServer.Proxy = PropertyServer -t:tcp -h 127.0.0.1 -p 9090


# Trace properties
# IceStorm.Trace.Subscriber = 2
# IceStorm.Trace.Topic = 2
# IceStorm.Trace.TopicManager = 1
# Ice.Trace.Network = 3
# Ice.Trace.Protocol = 1
# Ice.Trace.ThreadPool = 1
# Ice.Trace.Locator = 2


# Ice common properties
Ice.ThreadPool.Client.SizeMax = 10
Ice.ThreadPool.Server.SizeMax = 10