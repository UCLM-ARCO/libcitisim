# -*- mode: config; coding: utf-8 -*-

TestAdapter.Endpoints = tcp -h 127.0.0.1

# list of proxies
TopicManager.Proxy = IceStorm/TopicManager -t:tcp -h 127.0.0.1 -p 1111
WelcomeServer.Proxy = WelcomeServer -t:tcp -h 127.0.0.1 -p 1112
PropertyServer.Proxy = PropertyServer -t:tcp -h 127.0.0.1 -p 1113

# specific properties for LibCitisim
# LibCitisim.Debug = True
LibCitisim.UseBiDir = True
LibCitisimAdapter.Endpoints = tcp -h 127.0.0.1

Ice.ThreadPool.Client.SizeMax = 10
Ice.ThreadPool.Server.SizeMax = 10
# Ice.Trace.Protocol = 1