# -*- mode: config; coding: utf-8 -*-

IceBox.Service.IceStorm = IceStormService:createIceStorm --Ice.Config=tests.config
IceBox.PrintServicesReady = IceStorm is

IceStorm.TopicManager.Endpoints = tcp -h 127.0.0.1 -p 1111
IceStorm.Publish.Endpoints = tcp -h 127.0.0.1
IceStorm.LMDB.Path = /tmp/test-libcitisim-is-db
Freeze.DbEnv.IceStorm.DbHome = /tmp/test-libcitisim-is-db

TopicManager.Proxy = IceStorm/TopicManager -t:tcp -h 127.0.0.1 -p 1111
Adapter.Endpoints = tcp -h 127.0.0.1

PropertyService.Data = /tmp/ps.json
PropertyServiceAdapter.Endpoints = tcp -p 9090
PropertyService.Proxy = PropertyServer -t -e 1.1:tcp -h 127.0.0.1 -p 9090 -t 60000

# LibCitisim.Debug = True

Ice.ThreadPool.Client.SizeMax = 10
Ice.ThreadPool.Server.SizeMax = 10